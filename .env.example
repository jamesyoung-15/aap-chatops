chat_platform=slack

aap_api_token=<your-api-token>
aap_base_url=<your-aap-domain.com>

slack_bot_token=xoxb-
slack_app_token=xapp-

log_level=INFO

# Scheduled alerts. Schedules live in alerts.yaml; these are the environment
# specific bits. The bot must be a member of the channel it posts to.
# Set alerts_enabled=false on any second instance, otherwise two bots post the
# same alert to the same channel.
alerts_enabled=true
default_alert_channel_id=C0123456789
alert_timezone=America/Chicago
